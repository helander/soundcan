
{{define "fluidsynth"}}
  <div>
      <h4>Fluidsynth {{.}}</h4>
      {{template "fluidsynthpatch" .}}

      <form oninput="oput.value=ccslider.value">
        <div style="display: flex;">
           <output for="ccslider" name="oput" style="width: 4em;padding-right: 1em;text-align: right;">50</output>
           <div style="flex-grow: 1;">
              <input type="range" id="ccslider" name="ccvalue"
                     value="50" min="0" max="127" step="1"
                     hx-post="/port/{{.}}/midicc/0/7" hx-swap="none" hx-trigger="input"  
              />
           </div>
        </div>
      </form>
  </div>
{{end}}

{{define "fluidsynthpatch"}}
  <div>
      <select name="bank" hx-post="/fluidsynth/{{.}}/selectbank/0" hx-target="closest div" hx-swap="outerHTML">
        {{$bank:=(bank .)}}
        {{range banks .}}
          <option value="{{.}}" {{if eq . $bank}}selected {{end}}>{{.}}</option>
        {{end}}
      </select>
      <select name="program" hx-post="/fluidsynth/{{.}}/selectprogram/0" hx-target="closest div" hx-swap="outerHTML">
        {{$program:=(program .)}}
        {{range programs .}}
          <option value="{{.Program}}" {{if eq .Program $program}}selected{{end}} >{{.Name}}</option>
        {{end}}
      </select>
  </div>
{{end}}
