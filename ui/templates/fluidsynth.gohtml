
{{define "fluidsynth"}}
  <div style="accent-color: green">
      <h4>Fluidsynth  {{.Host}} {{.Port}}</h4>

      <h5>Reverb</h5>

      <form oninput="oput.value=settingslider.value">
        <div style="display: flex;">
	   <output style="width: 6em;text-align: left">Active</output>
           <output for="settingslider" name="oput" style="width: 4em;padding-right: 1em;text-align: right;">0</output>
           <div style="flex-grow: 1;">
              <input type="range" id="settingslider" name="settingvalue" style="width: 25%"
                     value="0" min="0" max="1" step="1"
                     hx-post="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.reverb.active" hx-swap="none" hx-trigger="input,load"  
                     hl-url="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.reverb.active" hl-swap="none" hl-trigger="input,load"  
              />
           </div>
        </div>
      </form>

      <form oninput="oput.value=settingslider.value">
        <div style="display: flex;">
	   <output style="width: 6em;text-align: left">Damp</output>
           <output for="settingslider" name="oput" style="width: 4em;padding-right: 1em;text-align: right;">0.29</output>
           <div style="flex-grow: 1;">
              <input type="range" id="settingslider" name="settingvalue" style="width: 50%"
                     value="0.29" min="0" max="1" step="0.01"
                     hx-post="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.reverb.damp" hx-swap="none" hx-trigger="input,load"  
                     hl-url="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.reverb.damp" hl-swap="none" hl-trigger="input,load"  
              />
           </div>
        </div>
      </form>

      <form oninput="oput.value=settingslider.value">
        <div style="display: flex;">
	   <output style="width: 6em;text-align: left">Level</output>
           <output for="settingslider" name="oput" style="width: 4em;padding-right: 1em;text-align: right;">0.62</output>
           <div style="flex-grow: 1;">
              <input type="range" id="settingslider" name="settingvalue" style="width: 50%"
                     value="0.62" min="0" max="1" step="0.01"
                     hx-post="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.reverb.level" hx-swap="none" hx-trigger="input,load"  
                     hl-url="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.reverb.level" hl-swap="none" hl-trigger="input,load"  
              />
           </div>
        </div>
      </form>

      <form oninput="oput.value=settingslider.value">
        <div style="display: flex;">
	   <output style="width: 6em;text-align: left">Room size</output>
           <output for="settingslider" name="oput" style="width: 4em;padding-right: 1em;text-align: right;">0.71</output>
           <div style="flex-grow: 1;">
              <input type="range" id="settingslider" name="settingvalue" style="width: 50%"
                     value="0.71" min="0" max="1" step="0.01"
                     hx-post="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.reverb.room-size" hx-swap="none" hx-trigger="input,load"  
                     hl-url="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.reverb.room-size" hl-swap="none" hl-trigger="input,load"  
              />
           </div>
        </div>
      </form>

      <form oninput="oput.value=settingslider.value">
        <div style="display: flex;">
	   <output style="width: 6em;text-align: left">Width</output>
           <output for="settingslider" name="oput" style="width: 4em;padding-right: 1em;text-align: right;">75</output>
           <div style="flex-grow: 1;">
              <input type="range" id="settingslider" name="settingvalue" style="width: 50%"
                     value="75" min="0" max="100" step="1"
                     hx-post="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.reverb.width" hx-swap="none" hx-trigger="input,load"  
                     hl-url="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.reverb.width" hl-swap="none" hl-trigger="input,load"  
              />
           </div>
        </div>
      </form>

      <h5>Chorus</h5>

      <form oninput="oput.value=settingslider.value">
        <div style="display: flex;">
	   <output style="width: 6em;text-align: left">Active</output>
           <output for="settingslider" name="oput" style="width: 4em;padding-right: 1em;text-align: right;">0</output>
           <div style="flex-grow: 1;">
              <input type="range" id="settingslider" name="settingvalue" style="width: 25%"
                     value="0" min="0" max="1" step="1"
                     hx-post="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.chorus.active" hx-swap="none" hx-trigger="input,load"  
                     hl-url="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.chorus.active" hl-swap="none" hl-trigger="input,load"  
              />
           </div>
        </div>
      </form>


      <form oninput="oput.value=settingslider.value">
        <div style="display: flex;">
	   <output style="width: 6em;text-align: left">Depth</output>
           <output for="settingslider" name="oput" style="width: 4em;padding-right: 1em;text-align: right;">3</output>
           <div style="flex-grow: 1;">
              <input type="range" id="settingslider" name="settingvalue" style="width: 50%"
                     value="3" min="0" max="256" step="1"
                     hx-post="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.chorus.depth" hx-swap="none" hx-trigger="input,load"  
                     hl-url="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.chorus.depth" hl-swap="none" hl-trigger="input,load"  
              />
           </div>
        </div>
      </form>


      <form oninput="oput.value=settingslider.value">
        <div style="display: flex;">
	   <output style="width: 6em;text-align: left">Level</output>
           <output for="settingslider" name="oput" style="width: 4em;padding-right: 1em;text-align: right;">4.8</output>
           <div style="flex-grow: 1;">
              <input type="range" id="settingslider" name="settingvalue" style="width: 50%"
                     value="4.8" min="0" max="10" step="0.1"
                     hx-post="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.chorus.level" hx-swap="none" hx-trigger="input,load"  
                     hl-url="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.chorus.level" hl-swap="none" hl-trigger="input,load"  
              />
           </div>
        </div>
      </form>


      <form oninput="oput.value=settingslider.value">
        <div style="display: flex;">
	   <output style="width: 6em;text-align: left">Voice count</output>
           <output for="settingslider" name="oput" style="width: 4em;padding-right: 1em;text-align: right;">2</output>
           <div style="flex-grow: 1;">
              <input type="range" id="settingslider" name="settingvalue" style="width: 50%"
                     value="2" min="0" max="99" step="1"
                     hx-post="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.chorus.nr" hx-swap="none" hx-trigger="input,load"  
                     hl-url="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.chorus.nr" hl-swap="none" hl-trigger="input,load"  
              />
           </div>
        </div>
      </form>


      <form oninput="oput.value=settingslider.value">
        <div style="display: flex;">
	   <output style="width: 6em;text-align: left">Speed</output>
           <output for="settingslider" name="oput" style="width: 4em;padding-right: 1em;text-align: right;">1.3</output>
           <div style="flex-grow: 1;">
              <input type="range" id="settingslider" name="settingvalue" style="width: 50%"
                     value="1.3" min="0.1" max="5" step="0.05"
                     hx-post="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.chorus.speed" hx-swap="none" hx-trigger="input,load"  
                     hl-url="/fluidsynth/{{.Host}}/{{.Port}}/setting/synth.chorus.speed" hl-swap="none" hl-trigger="input,load"  
              />
           </div>
        </div>
      </form>


      <h5>Channels</h5>
      {{template "fluidchannel" (fluidchannel .Host .Port "0" "1")}}
      {{template "fluidchannel" (fluidchannel .Host .Port "1" "1")}}
      {{template "fluidchannel" (fluidchannel .Host .Port "2" "2")}}
      {{template "fluidchannel" (fluidchannel .Host .Port "3" "2")}}

  </div>
{{end}}

{{define "fluidprogram"}}
      <form>
        <select name="font" style="font-size: 0.8em;accent-color: green;" 
                hx-post="/fluidsynth/{{.host}}/{{.port}}/selectfont/{{.channel}}" hx-target="closest form" hx-swap="outerHTML" hx-trigger="change,load" 
                hx-ext="event-header"
        >
          {{$font:=.font}}
          {{range (fonts .host .port)}}
            <option value="{{.Font}}" {{if eq .Font $font}}selected t{{end}}>{{.Filename}}</option>
          {{end}}
        </select>

        <select  name="bankpreset"  style="font-size: 1em;accent-color: green;" 
                 hx-post="/fluidsynth/{{.host}}/{{.port}}/setbankpreset/{{.channel}}" hx-swap="none"
        >
          {{range (index (fonts .host .port) .font).Instruments}}
            {{$bp:=printf "%s-%s" .Bank .Preset}}
            <option value="{{$bp}}" >{{.Name}}</option>
          {{end}}
        </select>
      </form>

{{end}}

{{define "fluidchannel"}}
  <div>
      <output>Channel {{.channel}}</output>

      {{template "fluidprogram" .}}

      <form oninput="oput.value=volumeslider.value">
        <div style="display: flex;">
	   <output style="width: 6em;text-align: left">Volume</output>
           <output for="volumeslider" name="oput" style="width: 7em;padding-right: 1em;text-align: right;">100</output>
           <div style="flex-grow: 1;">
              <input type="range" id="volumeslider" name="ccvalue" style="width: 50%;accent-color: green;"
                     value="100" min="0" max="127" step="1"
                     hx-post="/fluidsynth/{{.host}}/{{.port}}/midicc/{{.channel}}/7" hx-swap="none" hx-trigger="input,load"  
              />
           </div>
        </div>
      </form>
      <form oninput="oput.value=reverbslider.value">
        <div style="display: flex;">
	   <output style="width: 6em;text-align: left">Reverb send</output>
           <output for="reverbslider" name="oput" style="width: 7em;padding-right: 1em;text-align: right;">100</output>
           <div style="flex-grow: 1;">
              <input type="range" id="reverbslider" name="ccvalue" style="width: 50%;accent-color: green;"
                     value="100" min="0" max="127" step="1"
                     hx-post="/fluidsynth/{{.host}}/{{.port}}/midicc/{{.channel}}/91" hx-swap="none" hx-trigger="input,load"  
              />
           </div>
        </div>
      </form>
      <form oninput="oput.value=chorusslider.value">
        <div style="display: flex;">
	   <output style="width: 6em;text-align: left">Chorus send</output>
           <output for="chorusslider" name="oput" style="width: 7em;padding-right: 1em;text-align: right;">50</output>
           <div style="flex-grow: 1;">
              <input type="range" id="chorusslider" name="ccvalue" style="width: 50%;accent-color: green;"
                     value="50" min="0" max="127" step="1"
                     hx-post="/fluidsynth/{{.host}}/{{.port}}/midicc/{{.channel}}/93" hx-swap="none" hx-trigger="input,load"  
              />
           </div>
        </div>
      </form>
  </div>
{{end}}

